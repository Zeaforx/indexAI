# The default is a local SQLite database at ./catalog.sqlite3.
# PostgreSQL example for production or local Docker:
# ASSET_COMPASS_DB_URL=postgresql+psycopg://assetcompass:change-me@localhost:5432/assetcompass
ASSET_COMPASS_DB_URL=sqlite:///./catalog.sqlite3
# Local REST and MCP HTTP listener; binds 127.0.0.1 only.
ASSET_COMPASS_PORT=8000
# In-process requests per peer IP per 60 seconds (1–1000).
# Not authentication or a distributed/proxy-safe rate limit.
ASSET_COMPASS_RATE_LIMIT=120

